{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "tomalerda",
    "version":  "0.1.6",
    "identifier":  "com.tomalerda.app",
    "build":  {
                  "frontendDist":  "../src"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "tomalerda",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  980,
